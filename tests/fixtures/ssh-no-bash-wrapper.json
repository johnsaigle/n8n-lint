{
  "name": "SSH No Bash Wrapper",
  "nodes": [
    {
      "id": "trigger-manual",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "parameters": {},
      "position": [0, 0]
    },
    {
      "id": "ssh-unwrapped",
      "name": "Run Unwrapped",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "parameters": {
        "resource": "command",
        "operation": "execute",
        "command": "export PATH=/usr/local/bin:$PATH && gh run download --repo org/repo -n artifact --dir /tmp/out"
      },
      "position": [200, 0]
    },
    {
      "id": "error-trigger",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "parameters": {},
      "position": [400, 0]
    },
    {
      "id": "ntfy-notify",
      "name": "Notify ntfy",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "parameters": {
        "url": "http://172.17.0.1:8080",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Authorization", "value": "Basic YWRtaW46MTIzNDU2Nzg="}
          ]
        },
        "body": "={{ JSON.stringify({ topic: 'test', message: 'done' }) }}"
      },
      "position": [200, 200]
    }
  ],
  "connections": {},
  "tags": ["test"]
}
